{
  "name": "tillwick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A pixel-art town where every citizen is its own headless Claude session, trading over x402 on testnet",
  "scripts": {
    "gen-wallets": "tsx scripts/gen-wallets.ts",
    "gen-citizens": "tsx scripts/gen-citizens.ts",
    "stipend": "tsx stipend-server.ts",
    "fund-agents": "tsx scripts/fund-agents.ts",
    "balances": "tsx economy-balances.ts",
    "sim": "tsx sim/sim-server.ts",
    "drive": "tsx scripts/driver.ts",
    "shop": "tsx shops/shop-server.ts",
    "shops": "tsx shops/run-shops.ts",
    "citizen0": "tsx citizen0.ts",
    "citizen": "tsx citizens/citizen.ts",
    "citizens": "tsx citizens/run-all.ts",
    "billing-check": "tsx billing-check.ts",
    "observe": "tsx scripts/observe-windows.ts",
    "inspect": "tsx scripts/inspect-citizen.ts",
    "trace": "tsx scripts/trace-decision.ts",
