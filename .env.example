# ---- Phase 0 (testnet, throwaway) ----

# Claude auth (default): an Anthropic API key. See https://code.claude.com/docs/en/agent-sdk/quickstart
ANTHROPIC_API_KEY=
# Opt-in, personal local experiments only: use your own logged-in Claude subscription instead of a key,
# with CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`) or TILLWICK_USE_CLAUDE_LOGIN=1 (the CLI login).
# CLAUDE_CODE_OAUTH_TOKEN=
# TILLWICK_USE_CLAUDE_LOGIN=1

# Buyer = the citizen's funded wallet. FUND with USDC at https://faucet.circle.com (Base Sepolia).
BUYER_PRIVATE_KEY=
# Seller = the shop's payout address (no key needed to receive).
SELLER_ADDRESS=

# Shop + good (the shop runs on :4031)
SHOP_URL=http://localhost:4031
GOOD=bread
PRICE=$0.01

# How many autonomous ticks the citizen runs
TICKS=3

# ---- Treasury (central bank) for the agent economy ----
# The funded wallet that disperses USDC to citizens (required by fund-agents / stipend). Dispersal is gasless (x402), so it needs only USDC.
TREASURY_PRIVATE_KEY=
# Per-citizen stipend amount (treasury -> each citizen)
STIPEND=$0.02
